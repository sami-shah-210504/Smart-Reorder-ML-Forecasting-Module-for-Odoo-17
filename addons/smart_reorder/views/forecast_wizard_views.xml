<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_forecast_wizard_form" model="ir.ui.view">
        <field name="name">smart.forecast.wizard.form</field>
        <field name="model">smart.forecast.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    Products need at least 8 full weeks of confirmed sales history.
                </p>
                <group>
                    <field name="horizon_weeks"/>
                </group>
                <footer>
                    <button name="action_run" type="object" string="Run" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_forecast_wizard" model="ir.actions.act_window">
        <field name="name">Run Forecast</field>
        <field name="res_model">smart.forecast.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
